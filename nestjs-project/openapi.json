              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or not owned (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is no longer a draft (VIDEO_NOT_DRAFT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Re-issue presigned part URLs",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}/upload/complete": {
      "post": {
        "description": "Verifies the stored parts (coverage, ETags and real size against the declared size), assembles the file, moves the video to processing and enqueues the processing job. A size mismatch aborts the upload and marks the video as failed. Owner only.",
        "operationId": "VideosController_completeUpload",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Video id (UUID)",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteUploadDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Upload completed; processing queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed, parts missing/mismatched (UPLOAD_INCOMPLETE) or stored size differs from the declared size (UPLOAD_SIZE_MISMATCH)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or not owned (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is no longer a draft (VIDEO_NOT_DRAFT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Complete the upload and start processing",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{shortId}/stream": {
      "get": {
        "description": "Redirects to a presigned URL served inline by object storage, which answers Range requests with 206 Partial Content — playback starts without downloading the whole file. Public; only ready videos are reachable.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "shortId",
            "required": true,
            "in": "path",
            "description": "Public short id of the video (11 base62 characters)",
            "schema": {
              "example": "aZ3kQ9xT0bL",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the inline video URL",
            "headers": {
              "Location": {
                "description": "Presigned object-storage URL (valid S3_DELIVERY_URL_TTL seconds)",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "404": {
            "description": "Unknown short id, or the video is not ready yet (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Stream a ready video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{shortId}/download": {
      "get": {
        "description": "Redirects to a presigned URL that makes object storage send the file as an attachment named after the original file name. Public; only ready videos are reachable.",
        "operationId": "VideosController_download",
        "parameters": [
          {
            "name": "shortId",
            "required": true,
            "in": "path",
            "description": "Public short id of the video (11 base62 characters)",
            "schema": {
              "example": "aZ3kQ9xT0bL",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the attachment download URL",
            "headers": {
              "Location": {
                "description": "Presigned object-storage URL (valid S3_DELIVERY_URL_TTL seconds)",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "404": {
            "description": "Unknown short id, or the video is not ready yet (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Download a ready video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{shortId}/thumbnail": {
      "get": {
        "description": "Redirects to a presigned URL of the JPEG thumbnail generated during processing. Public; only ready videos are reachable.",
        "operationId": "VideosController_thumbnail",
        "parameters": [
          {
            "name": "shortId",
            "required": true,
            "in": "path",
            "description": "Public short id of the video (11 base62 characters)",
            "schema": {
              "example": "aZ3kQ9xT0bL",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the JPEG thumbnail URL",
            "headers": {
              "Location": {
                "description": "Presigned object-storage URL (valid S3_DELIVERY_URL_TTL seconds)",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "404": {
            "description": "Unknown short id, or the video is not ready yet (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Get the thumbnail of a ready video",
        "tags": [
          "videos"
        ]
      }
    }
  },
